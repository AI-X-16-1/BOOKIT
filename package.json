{
  "name": "bookit",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "icons": "node scripts/generate-icons.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "prepare": "git config core.hooksPath .githooks || true",
    "test:rls": "node supabase/tests/rls.test.mjs",
    "check:supabase": "node scripts/check-supabase.mjs",
    "audit:prod": "node scripts/prod-audit.mjs",
    "demo:reset": "node --env-file-if-exists=.env.local scripts/demo-reset.mjs",
    "books:smoke": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/books-smoke.ts",
    "test:books": "node --conditions=react-server --import tsx --test src/modules/books/schema.test.ts src/modules/books/server/tags.test.ts src/modules/books/server/response.test.ts src/modules/books/server/source.test.ts src/modules/books/server/search.test.ts src/modules/books/server/recommend.test.ts src/modules/books/server/library-availability.test.ts",
    "ai:smoke": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/ai-smoke.ts",
    "llm:models": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/llm-models.ts",
    "ai:gaps": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/ai-gaps.ts",
    "ai:tags": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/ai-tags.ts",
    "ai:retag": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/ai-retag.ts",
    "ai:calibrate": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/ai-calibrate.ts",
    "ai:book-text": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/ai-book-text.ts",
    "ai:core-claim": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/ai-core-claim.ts",
    "ai:question": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/ai-question.ts",
    "reader:dict": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/dict-check.ts",
    "reader:import": "node --conditions=react-server --env-file-if-exists=.env.local --import tsx scripts/reader-import.ts",
    "test:reader": "node --conditions=react-server --import tsx --test src/modules/reader/readAlong.test.ts src/modules/reader/breath.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@google/genai": "^2.21.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "fast-xml-parser": "^5.11.1",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
