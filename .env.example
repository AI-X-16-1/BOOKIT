# ── Supabase ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only. never expose to the client

# ── LLM (one vendor in production — CLAUDE.md §1) ──
LLM_PROVIDER=anthropic              # anthropic | gemini
                                    # 2026-09-16 anthropic 으로 전환 (#54). Google 생성형 AI 약관이
                                    # 18세 미만이 접근할 서비스를 금지한다 — Gemini API, Vertex AI 둘 다.
                                    # gemini 어댑터는 로컬 비교용으로만 남긴다. 운영에 쓰지 않는다
LLM_API_KEY=                        # server only. never expose to the client
LLM_MODEL=claude-sonnet-5           # exact model string — run `npm run llm:models` to see valid values.
                                    # also goes in the contest submission (plan-ko.md §1-3)
                                    # 캘리브레이션(npm run ai:calibrate 20건)은 이 모델로 다시 잰다 — #54
LLM_MODEL_FALLBACK=claude-haiku-4-5-20251001
                                    # comma-separated. used when LLM_MODEL keeps returning 503 or 429.
                                    # 9/20: opus-5 → haiku-4.5 — 폴백은 비상용이라 더 싼 모델로 (김민경)
LLM_EFFORT=                         # anthropic only: low | medium | high | xhigh | max. blank = medium
                                    # 사고 토큰이 출력 요금에 들어간다. 지연·비용이 크면 low 부터 본다
LLM_THINKING_LEVEL=                 # gemini only: minimal | low | medium | high. blank = model default

# 로컬 배치 전용 — `npm run covers:generate` (표지 일러스트, scripts/covers-generate.mjs).
# 런타임 코드는 안 읽는다. Vercel 에 넣지 않는다.
OPENAI_API_KEY=

# ── Judge demo login (contest judging only — modules/auth/server/demo.ts) ──
DEMO_LOGIN_ENABLED=false            # true only on production during judging. /auth/demo?as=student|teacher
DEMO_LOGIN_UNTIL=2026-10-17         # door closes after this day (KST) even if ENABLED stays true
DEMO_STUDENT_EMAIL=                 # blank = demo@bookit.demo (seed.sql)
DEMO_TEACHER_EMAIL=                 # blank = teacher2@bookit.demo (seed.sql)

# ── Verification tuning (adjustable before the demo) ──
ANSWER_WINDOW_SEC=45                # 30-60
PASS_THRESHOLD=moderate             # moderate | strict
                                    # flash 20건 검증: moderate 17/18, strict 16/18 일치 —
                                    # 심사위원이 데모하다 튕기는 것이 가장 나쁜 결과라 moderate 로 둔다
POINTS_PER_PASS=50

# ── Book APIs ───────────────────────────────
ALADIN_TTB_KEY=
DATA_GO_KR_KEY=                     # 국립어린이청소년도서관 사서추천도서
NLK_API_KEY=                        # 국립중앙도서관
KRDICT_API_KEY=                     # 국립국어원 한국어기초사전

# ── App ─────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
