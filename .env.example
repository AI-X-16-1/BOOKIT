# ── Supabase ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only. never expose to the client

# ── LLM (vendor fixed on day 1: anthropic) ──
LLM_PROVIDER=anthropic              # anthropic only. anything else throws at call time
LLM_API_KEY=                        # server only. never expose to the client
LLM_MODEL=claude-opus-5             # exact model string — also goes in the contest submission
LLM_EFFORT=                         # low | medium | high | xhigh | max. blank = per-call default (medium)

# ── Verification tuning (adjustable before the demo) ──
ANSWER_WINDOW_SEC=45                # 30-60
PASS_THRESHOLD=moderate             # moderate | strict
POINTS_PER_PASS=50

# ── Book APIs ───────────────────────────────
ALADIN_TTB_KEY=
DATA_GO_KR_KEY=                     # 국립어린이청소년도서관 사서추천도서
NLK_API_KEY=                        # 국립중앙도서관
KRDICT_API_KEY=                     # 국립국어원 한국어기초사전

# ── App ─────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
