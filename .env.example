# ── Supabase ────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only. never expose to the client

# ── LLM (one vendor in production — CLAUDE.md §1) ──
LLM_PROVIDER=gemini                 # gemini | anthropic
LLM_API_KEY=                        # server only. never expose to the client
LLM_MODEL=gemini-3.5-flash          # exact model string — run `npm run llm:models` to see valid values.
                                    # also goes in the contest submission (plan-ko.md §1-3)
                                    # validated by `npm run ai:calibrate` on gemini-3.5-flash
                                    # (독후감 20건: 대필 판별 5/5, 채점 17/18 일치 — #29)
LLM_MODEL_FALLBACK=gemini-3.5-flash-lite,gemini-3.6-flash
                                    # comma-separated. used when LLM_MODEL keeps returning 503 or 429
LLM_EFFORT=                         # anthropic only: low | medium | high | xhigh | max. blank = medium
LLM_THINKING_LEVEL=                 # gemini only: minimal | low | medium | high. blank = model default
                                    # low 는 flash 기본값보다 빈틈·질문이 절반쯤 빠르다 (issue #36).
                                    # minimal 은 빈틈을 덜 찾아서 권하지 않는다

# ── Verification tuning (adjustable before the demo) ──
ANSWER_WINDOW_SEC=45                # 30-60
PASS_THRESHOLD=moderate             # moderate | strict
                                    # flash 20건 검증: moderate 17/18, strict 16/18 일치 —
                                    # 심사위원이 데모하다 튕기는 것이 가장 나쁜 결과라 moderate 로 둔다
POINTS_PER_PASS=50

# ── Book APIs ───────────────────────────────
ALADIN_TTB_KEY=
DATA_GO_KR_KEY=                     # 국립어린이청소년도서관 사서추천도서
NLK_API_KEY=                        # 국립중앙도서관
KRDICT_API_KEY=                     # 국립국어원 한국어기초사전

# ── App ─────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
